# OpenAI API key. The only paid resource in this project (CLAUDE.md section 3).
OPENAI_API_KEY=

# OpenAI vision model to use. Required; the app refuses to start without it.
# Never hardcoded in code (CLAUDE.md section 4). You choose which model exists.
OPENAI_MODEL=

# Threshold used only by eval/run_eval.py's calibration report (CLAUDE.md section 7).
# The app does not gate on confidence. Optional. Default: 0.80
CONFIDENCE_THRESHOLD=0.80

# Postgres connection URL. Optional. If unset, SQLite at data/app.db is used (CLAUDE.md section 4).
DATABASE_URL=

# Per-million-token USD prices of OPENAI_MODEL, used only to estimate cost in logs and the
# audit trail (CLAUDE.md section 3). Optional. If unset, cost is logged as unknown.
# Prices are never hardcoded: look them up for the model you chose.
OPENAI_PRICE_INPUT_PER_1M_USD=
OPENAI_PRICE_OUTPUT_PER_1M_USD=
